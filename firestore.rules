rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null &&
          request.auth.token.email.lower() == 'smsheam1@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/roles/$(request.auth.uid))
      );
    }

    function isRoomHost(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isRoomClosed(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.status in ['CLOSED', 'EXPIRED'];
    }

    function isRoomMemberAfter(roomId) {
      return isSignedIn() &&
        existsAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isAssignedImposter(roomId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/private/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)/private/$(request.auth.uid)).data.role == 'imposter';
    }

    function roomIdentityIsUnchanged() {
      return request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.hostSessionToken == resource.data.hostSessionToken &&
        request.resource.data.roomCode == resource.data.roomCode &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /game_config/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_health/{document=**} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin()) &&
        request.resource.data.uid == userId;
      allow delete: if isAdmin();
    }

    match /roles/{userId} {
      allow get, list, write: if isAdmin();
    }

    match /admins/{adminId} {
      allow get, list, write: if isAdmin();
    }

    match /match_history/{matchId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.resource.data.roomCode is string &&
          isRoomHost(request.resource.data.roomCode));
      allow delete: if isAdmin();
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isAdmin();

      allow create: if isSignedIn() && isValidId(roomId) &&
        request.resource.data.roomCode == roomId &&
        request.resource.data.hostId == request.auth.uid;

      allow update: if isSignedIn() && isValidId(roomId) && roomIdentityIsUnchanged() && (
        isRoomHost(roomId) || isAdmin() ||
        (
          (isRoomMember(roomId) || isRoomMemberAfter(roomId)) && (
            (
              resource.data.currentPhase == 'CLUE' &&
              (
                resource.data.clueTurnPlayerId == request.auth.uid ||
                (
                  resource.data.clueTurnPlayerId == null &&
                  resource.data.clueTurnIndex >= resource.data.clueOrder.size()
                )
              ) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['clueTurnIndex', 'clueTurnPlayerId', 'phaseEndsAt',
                  'currentPhase', 'lastActivityAt', 'updatedAt'])
            ) ||

            (
              resource.data.currentPhase == 'IMPOSTER_GUESS' &&
              isAssignedImposter(roomId) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['currentPhase', 'imposterGuessedWord', 'imposterGuessAnswer',
                  'winner', 'scoreDetails', 'phaseEndsAt', 'lastActivityAt', 'updatedAt'])
            ) ||

            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['nextRoundConfirmed', 'lastActivityAt', 'updatedAt']) &&
              request.resource.data.nextRoundConfirmed is list &&
              request.resource.data.nextRoundConfirmed.hasAny([request.auth.uid])
            ) ||

            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'closedReason', 'updatedAt']) &&
              (
                (
                  resource.data.hostDisconnectedAt is number &&
                  request.time.toMillis() - resource.data.hostDisconnectedAt > 60000
                ) ||
                (
                  resource.data.lastActivityAt is number &&
                  request.time.toMillis() - resource.data.lastActivityAt > (resource.data.status == 'PLAYING' ? 600000 : 900000)
                )
              ) &&
              request.resource.data.status in ['CLOSED', 'EXPIRED']
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'closedReason', 'playerCount', 'updatedAt']) &&
              request.resource.data.status == 'CLOSED' &&
              request.resource.data.closedReason == 'empty_room' &&
              request.resource.data.playerCount == 0
            )
          )
        )
      );

      allow delete: if isRoomHost(roomId) || isAdmin();

      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId);
        allow list: if isSignedIn() && isValidId(roomId);

        allow create: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          request.auth.uid == playerId &&
          request.resource.data.id == playerId;

        allow update: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && (
          isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId) ||
          (
            get(/databases/$(database)/documents/rooms/$(roomId)).data.currentPhase == 'IMPOSTER_GUESS' &&
            isAssignedImposter(roomId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
          ) ||
          (
            request.auth.uid == playerId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'avatar', 'isReady', 'hasVoted', 'hasSeenCard',
                'clue', 'connectionStatus', 'lastSeenAt', 'disconnectedAt',
                'canRejoinUntil', 'sessionToken'])
          )
        );

        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          (request.auth.uid == playerId || isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId));
      }

      match /private/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          request.auth.uid == playerId;
        allow list: if false;
        allow create, update: if isRoomHost(roomId) || isAdmin();
        allow delete: if isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId);
      }

      match /votes/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          isRoomMember(roomId);
        allow list: if isRoomMember(roomId);

        allow create, update: if isSignedIn() && isValidId(roomId) &&
          isValidId(playerId) && request.auth.uid == playerId &&
          isRoomMember(roomId) &&
          request.resource.data.voterId == request.auth.uid;
        allow delete: if isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId);
      }

      // Legacy lobby chat documents can only be read and deleted during cleanup.
      match /messages/{messageId} {
        allow get, list: if isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId);
        allow delete: if isRoomHost(roomId) || isAdmin() || isRoomClosed(roomId);
      }

      // Lobby chat was removed. Legacy messages are inaccessible and are purged during room cleanup.
    }
  }
}
