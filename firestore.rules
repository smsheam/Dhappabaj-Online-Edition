rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isRoomHost(roomId) {
      return isSignedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'smsheam1@gmail.com' ||
          request.auth.token.email.lower() == 's m sheam1@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/roles/$(request.auth.uid))
      );
    }

    // Dynamic game configuration (Custom words, Quick chats, Scoring rules, Game texts)
    match /game_config/{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Health ping
    match /system_health/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Registered and Guest Player Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Role & Permissions records (Owner and Editors)
    match /roles/{userId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin records
    match /admins/{adminId} {
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Completed Match History records
    match /match_history/{matchId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Room collection
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn();

      // Create room: user sets themselves as host
      allow create: if isSignedIn() && isValidId(roomId) &&
        request.resource.data.hostId == request.auth.uid;

      // Update room: host can update any room state, or players can update phase/round state when permitted
      allow update: if isSignedIn() && isValidId(roomId);

      // Delete room: host or super admin
      allow delete: if isRoomHost(roomId) || isAdmin();

      // Players subcollection
      match /players/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId);
        allow list: if isSignedIn() && isValidId(roomId);

        // Player joins as themselves
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          request.auth.uid == playerId;

        // Player updates their own status/name/ready/clue/hasSeenCard, or host updates scores
        allow update: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          (request.auth.uid == playerId || isRoomHost(roomId) || isAdmin());

        // Player can leave, or host can kick
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          (request.auth.uid == playerId || isRoomHost(roomId) || isAdmin());
      }

      // Private role and word subcollection (strictly guarded)
      match /private/{playerId} {
        // CRITICAL: Only the assigned player can read their own secret role, word and hint!
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          request.auth.uid == playerId;
        allow list: if false;

        // Writing role assignments is done by the host when round starts
        allow create, update: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          (isRoomHost(roomId) || request.auth.uid == playerId);
        allow delete: if isRoomHost(roomId) || isAdmin();
      }

      // Votes subcollection
      match /votes/{playerId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(playerId);
        allow list: if isSignedIn() && isValidId(roomId);

        // Only the voter can cast or update their own vote
        allow create, update: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          request.auth.uid == playerId;
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId) &&
          (request.auth.uid == playerId || isRoomHost(roomId) || isAdmin());
      }

      // Live discussion messages subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(roomId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isRoomHost(roomId) || isAdmin();
      }
    }
  }
}
